#!/usr/bin/env python3
"""ab-dash — HTML-дашборд A/B-тестов: слоты, стадии, дедлайны, ссылки.

  ab-dash            собрать и открыть в браузере
  ab-dash --no-open  только собрать
"""
import re, sys, json, os, ssl, datetime, urllib.parse, urllib.request, urllib.error, html, subprocess
from pathlib import Path
import yaml

ROOT = Path(__file__).resolve().parent.parent
CFG = yaml.safe_load((ROOT / "config.yml").read_text(encoding="utf-8"))
_local = ROOT / "config.local.yml"          # личное: pm, products — не в git
if _local.exists():
    for k, v in (yaml.safe_load(_local.read_text(encoding="utf-8")) or {}).items():
        if isinstance(v, dict) and isinstance(CFG.get(k), dict): CFG[k].update(v)
        else: CFG[k] = v
PL = CFG.get("plausible") or {}
SLOTS = CFG["slots"]
TODAY = datetime.date.today()
OUT = ROOT / "dashboard.html"

STAGE_RU = {"incoming": "Входящая", "card": "Карточка", "design_sync": "Дизайн-синк",
            "feasibility": "Реализуемость", "scheduling": "Планирование",
            "development": "Разработка", "qa": "QA", "running": "Идёт",
            "analysis": "Анализ", "rollout": "Выкат/откат",
            "closing": "Закрытие хвоста", "closed": "Закрыт"}
LIVE = {"running", "analysis", "rollout"}
DEBT = {"closing"}


def ssl_ctx():
    ctx = ssl.create_default_context()
    if not ssl.get_default_verify_paths().cafile:
        try:
            import certifi; ctx.load_verify_locations(cafile=certifi.where())
        except Exception: pass
    return ctx


def api(path, params):
    b = (PL.get("base_url") or "").rstrip("/")
    f = Path(os.path.expanduser(PL.get("key_file") or "~/.plausible-key"))
    if not b or b == "ЗАПОЛНИ" or not f.exists():
        return None
    url = f"{b}/api/v1/stats/{path}?" + urllib.parse.urlencode(params)
    req = urllib.request.Request(url, headers={"Authorization": f"Bearer {f.read_text().strip()}"})
    try:
        with urllib.request.urlopen(req, timeout=25, context=ssl_ctx()) as r:
            return json.loads(r.read().decode("utf-8"))
    except Exception:
        return None


def product_of(t):
    """Продукт теста: явное поле → платформа → имя продукта в заголовке → первый в product_map."""
    if t.get("product"):
        return str(t["product"]).lower()
    plat = (CFG.get("platforms") or {}).get(t.get("platform") or "", {})
    if plat.get("product"):
        return plat["product"]
    title = str(t.get("title", "")).lower()
    for prod in all_products():                 # имя продукта в заголовке
        if prod in title:
            return prod
    return all_products()[0]


def all_products():
    return list((CFG.get("product_map") or {}).keys()) or ["default"]


def my_products():
    return [str(p).lower() for p in (CFG.get("products") or all_products())]


def load_tests():
    out = []
    for p in sorted((ROOT / "tests").glob("*.md")):
        raw = p.read_text(encoding="utf-8")
        if not raw.startswith("---"): continue
        try: d = yaml.safe_load(raw.split("---", 2)[1]) or {}
        except yaml.YAMLError: continue
        d.setdefault("id", p.stem); d.setdefault("stage", "incoming")
        if product_of(d) not in my_products():
            continue  # не мой продукт
        out.append(d)
    return out


def slot_live(platform):
    """Что реально летит в слоты платформы. -> {slot: [(value, visitors)]}"""
    sid = (PL.get("site_ids") or {}).get(platform)
    if not sid or sid == "ЗАПОЛНИ": return None
    res = {}
    for slot in SLOTS:
        r = api("breakdown", {"site_id": sid, "property": f"event:props:{slot}",
                              "metrics": "visitors", "period": "30d", "limit": 50})
        if r is None: return None
        rows = [(str(x.get(slot) or ""), x.get("visitors") or 0) for x in r.get("results", [])]
        res[slot] = [(v, n) for v, n in rows if v not in ("(none)", "", "none")]
    return res


def as_date(v):
    if isinstance(v, datetime.date): return v
    if isinstance(v, str):
        try: return datetime.date.fromisoformat(v.strip())
        except ValueError: return None
    return None


def deadlines(t):
    out = []
    for field, label in (("code_freeze", "код-фриз"), ("planned_stop", "остановка")):
        d = as_date(t.get(field))
        if d: out.append((d, label, (d - TODAY).days))
    da = as_date(t.get("decision_at"))
    if da and not t.get("code_removed_released_at"):
        due = da + datetime.timedelta(days=CFG["warn_before_days"]["cleanup"])
        out.append((due, "выпилить", (due - TODAY).days))
    return out


def e(x): return html.escape(str(x if x is not None else ""))


def links_of(t):
    out = []
    tasks = t.get("tasks") or {}
    labels = [("design", "дизайн"), ("dev", "разработка"), ("backend", "бэк"),
              ("backend_close", "закрытие"), ("cleanup", "выпиливание")]
    for k, lab in labels:
        v = tasks.get(k)
        if v:
            out.append(f'<a class="chip link" href="https://jira.int.agrd.dev/browse/{e(v)}">'
                       f'<i>{lab}</i>{e(v)}</a>')
    if t.get("research_card"):
        out.append(f'<a class="chip link nb" href="{e(t["research_card"])}">Notion</a>')
    return "".join(out) or '<span class="chip empty">задач нет</span>'


STAGES = CFG["stages"]


def stage_ge(t, name):
    """Стадия теста не раньше указанной."""
    try:
        return STAGES.index(t.get("stage", "incoming")) >= STAGES.index(name)
    except ValueError:
        return False


def issues(t):
    """Что недоделано. -> [(критично?, текст)]"""
    out, tasks = [], (t.get("tasks") or {})
    st = t.get("stage", "incoming")

    # ── закрытый тест: важно одно — выпилен ли код ──
    if st == "closed":
        if not tasks.get("backend_close"):
            out.append((True, "нет задачи на закрытие теста на бэке"))
        elif not t.get("backend_finished_at"):
            out.append((False, "не записана дата закрытия на бэке"))
        if not t.get("code_removed_version"):
            out.append((True, "код не выпилен из клиента"))
        return out

    if stage_ge(t, "development"):
        if not tasks.get("backend"):
            out.append((True, "нет бэк-задачи — тест не посчитается"))
        if not t.get("experiment_name"):
            out.append((True, "не задан experiment_name"))
    if stage_ge(t, "scheduling") and not t.get("slot"):
        out.append((True, "не назначен слот"))

    # ── хвост: решение принято, кода нет ──
    if st in DEBT or (as_date(t.get("decision_at")) and st != "closed"):
        if not tasks.get("backend_close"):
            out.append((True, "нет бэк-задачи на закрытие теста"))
        elif not t.get("backend_finished_at"):
            out.append((False, "не записана дата закрытия на бэке"))
        if not t.get("code_removed_version"):
            out.append((True, "код не выпилен — слот остаётся грязным"))

    if stage_ge(t, "development"):
        if not tasks.get("cleanup"):
            out.append((False, "нет задачи на выпиливание"))
        if not tasks.get("design"):
            out.append((False, "нет дизайн-задачи"))
    if not t.get("research_card"):
        out.append((False, "нет карточки в Research Board"))
    # выборку считают до запуска; после старта напоминать поздно
    if st in ("scheduling", "development") and not t.get("sample_size_per_variation"):
        out.append((False, "не посчитана выборка"))
    return out


def issues_html(t):
    it = issues(t)
    if not it:
        return '<span class="ok">всё на месте</span>'
    return "".join(f'<span class="iss {"crit" if c else ""}">{e(txt)}</span>'
                   for c, txt in it)


EXAMPLES = [
    ("Продуктовая: проработка теста", "01-product.md", "появилась гипотеза · тип Product"),
    ("Дизайн", "02-design.md", "планирование релиза · тип Design"),
    ("Бэк: регистрация теста", "03-backend-register.md", "планирование релиза · проект ADG"),
    ("Разработка", "04-dev.md", "планирование релиза · проект AG"),
    ("Выпиливание из клиента", "05-cleanup.md", "создаётся с dev-задачей, версия — после решения"),
    ("Бэк: закрытие теста", "06-backend-close.md", "решение по тесту · проект ADG"),
    ("Дизайн: обновление макетов", "07-design-update.md", "решение по тесту · только если победил B"),
    ("Телеметрия: правки по итогам разведки", "08-telemetry-fixes.md", "подготовка · если нашлись проблемы в разметке"),
]


def md_lite(text):
    """Минимальный markdown -> HTML: заголовки, списки, таблицы, код, жирный."""
    out, rows, lst = [], [], False

    def flush_table():
        nonlocal rows
        if not rows: return
        head, body = rows[0], [r for r in rows[1:] if not set(r.replace("|", "").strip()) <= set("-: ")]
        th = "".join(f"<th>{inline(c)}</th>" for c in head.strip("|").split("|"))
        tb = "".join("<tr>" + "".join(f"<td>{inline(c)}</td>" for c in r.strip("|").split("|")) + "</tr>"
                     for r in body)
        out.append(f'<table class="rules"><thead><tr>{th}</tr></thead><tbody>{tb}</tbody></table>')
        rows = []

    def inline(x):
        x = e(x.strip())
        x = re.sub(r"\*\*(.+?)\*\*", r"<strong>\1</strong>", x)
        x = re.sub(r"`(.+?)`", r"<code>\1</code>", x)
        x = re.sub(r"(?<!\*)\*([^*]+?)\*(?!\*)", r"<em>\1</em>", x)
        return x

    for line in text.splitlines():
        st = line.strip()
        if st.startswith("|"):
            if lst: out.append("</ul>"); lst = False
            rows.append(st); continue
        flush_table()
        if not st:
            if lst: out.append("</ul>"); lst = False
            continue
        if st.startswith("# "):
            continue
        if st.startswith("## "):
            if lst: out.append("</ul>"); lst = False
            out.append(f"<h4>{inline(st[3:])}</h4>"); continue
        if st.startswith("- "):
            if not lst: out.append("<ul>"); lst = True
            out.append(f"<li>{inline(st[2:])}</li>"); continue
        if lst: out.append("</ul>"); lst = False
        out.append(f"<p>{inline(st)}</p>")
    if lst: out.append("</ul>")
    flush_table()
    return "".join(out)


def rules_html():
    f = ROOT / "RULES.md"
    return md_lite(f.read_text(encoding="utf-8")) if f.exists() else ""


def examples_html():
    out = ""
    for title, fname, note in EXAMPLES:
        f = ROOT / "templates" / "examples" / fname
        if not f.exists(): continue
        out += (f'<details><summary>{e(title)} <span class="muted">— {e(note)}</span></summary>'
                f'<pre>{e(f.read_text(encoding="utf-8"))}</pre></details>')
    return out


SCRIPT = """<script>
(function(){
  const stats=[...document.querySelectorAll('.stat')];
  const rows=[...document.querySelectorAll('.row')];
  const slots=[...document.querySelectorAll('.slot')];
  const plats=[...document.querySelectorAll('.plat')];
  const secT=document.getElementById('s-tests');
  const secS=document.getElementById('s-slots');
  const secH=document.getElementById('s-history');
  const cnt=document.getElementById('cnt');
  const reset=document.getElementById('reset');
  const empty=document.getElementById('empty');
  let cur=null;

  const has=(el,f)=>(el.dataset.f||'').split(' ').includes(f);

  function apply(f){
    cur = (f===cur||f==='all') ? null : f;
    stats.forEach(b=>b.classList.toggle('on', !!cur && b.dataset.f===cur));
    reset.hidden = !cur;

    if(cur==='history'){
      secH.scrollIntoView({behavior:'smooth',block:'start'});
      cur=null; stats.forEach(b=>b.classList.remove('on')); reset.hidden=true;
      return;
    }
    const slotMode = cur==='dirty';
    secT.hidden = slotMode;
    secS.hidden = !!cur && !slotMode;

    slots.forEach(s=>{ s.hidden = slotMode && !has(s,'dirty'); });
    plats.forEach(p=>{
      const vis=[...p.querySelectorAll('.slot')].some(s=>!s.hidden);
      p.hidden = slotMode && !vis;
    });

    let n=0;
    rows.forEach(r=>{ const ok = !cur || has(r,cur); r.hidden=!ok; if(ok) n++; });
    cnt.textContent = cur ? n : rows.length;
    empty.hidden = !(cur && n===0);
    if(cur && !slotMode) secT.scrollIntoView({behavior:'smooth',block:'start'});
  }

  stats.forEach(b=>b.addEventListener('click',()=>apply(b.dataset.f)));

  const rfs=[...document.querySelectorAll('.rf')];
  const rrows=[...document.querySelectorAll('table.reg tbody tr')];
  rfs.forEach(b=>b.addEventListener('click',()=>{
    const st=b.dataset.st, on=b.classList.contains('on');
    rfs.forEach(x=>x.classList.remove('on'));
    if(on||st==='all'){ rrows.forEach(r=>r.hidden=false); return; }
    b.classList.add('on');
    rrows.forEach(r=>{ r.hidden = r.dataset.st!==st; });
  }));
  reset.addEventListener('click',()=>apply('all'));
})();
</script>"""


def data_age():
    """Сколько дней назад последний раз менялись карточки тестов."""
    files = list((ROOT / "tests").glob("*.md"))
    if not files:
        return None
    newest = max(f.stat().st_mtime for f in files)
    return (datetime.date.today() - datetime.date.fromtimestamp(newest)).days


def freshness_html():
    d = data_age()
    if d is None:
        return ""
    if d == 0:
        return '<span class="fresh ok">данные о тестах обновлены сегодня</span>'
    word = "день" if d == 1 else ("дня" if d < 5 else "дней")
    txt = f"данные о тестах обновлялись {d} {word} назад"
    if d >= 7:
        return (f'<span class="fresh stale">{txt} — пора запустить '
                f'<code>/ab-sync</code></span>')
    return f'<span class="fresh">{txt}</span>'


def registry_rows():
    """Строки таблицы из NAMES-REGISTRY.md -> [dict]."""
    f = ROOT / "NAMES-REGISTRY.md"
    if not f.exists():
        return []
    rows, seen_header = [], False
    for line in f.read_text(encoding="utf-8").splitlines():
        if not line.startswith("|"):
            continue
        cells = [c.strip() for c in line.strip("|").split("|")]
        if cells and cells[0] == "experiment_name":
            seen_header = True; continue
        if not seen_header or set(cells[0]) <= set("-: "):
            continue
        if len(cells) < 6:
            continue
        rows.append(dict(zip(("name", "product", "platform", "reg", "close", "state"), cells)))
    return rows


def registry_html():
    rows = registry_rows()
    if not rows:
        return ('<div class="muted">Библиотека пуста. Заполнить: <code>/ab-sync</code> '
                'в чате — она соберёт все тесты всех продуктов из бэк-задач ADG.</div>')
    states = ["идёт", "закрывается", "закрыт", "не зарегистрирован"]
    cnt = {st: sum(1 for r in rows if r["state"] == st) for st in states}
    mine = my_products()
    other = sum(1 for r in rows if not any(p in r["product"].lower() for p in mine))
    chips = "".join(
        f'<button class="rf" data-st="{e(st)}">{e(st)} <b>{cnt[st]}</b></button>'
        for st in states if cnt[st])
    chips += f'<button class="rf" data-st="all">все <b>{len(rows)}</b></button>'
    tone = {"идёт": "live", "закрывается": "debt", "закрыт": "done", "не зарегистрирован": "prep"}
    body = ""
    for r in rows:
        prod_cls = "" if any(p in r["product"].lower() for p in mine) else "other"
        body += (f'<tr data-st="{e(r["state"])}" class="{prod_cls}">'
                 f'<td><code>{e(r["name"])}</code></td>'
                 f'<td>{e(r["product"])}</td><td>{e(r["platform"])}</td>'
                 f'<td class="muted">{e(r["reg"])}</td><td class="muted">{e(r["close"])}</td>'
                 f'<td><span class="stage {tone.get(r["state"], "")}">{e(r["state"])}</span></td></tr>')
    return (f'<div class="rfilters">{chips}</div>'
            f'<div class="muted" style="margin:6px 0 10px">Все продукты — чужих {other}, приглушены. '
            f'Источник — бэк-задачи ADG: регистрация и закрытие.</div>'
            f'<table class="compact reg"><thead><tr><th>experiment_name</th><th>Продукт</th>'
            f'<th>Платформа</th><th>Регистрация</th><th>Закрытие</th><th>На бэке</th></tr></thead>'
            f'<tbody>{body}</tbody></table>')


def decision_ru(d):
    return {"ship": "выкатили", "rollback": "откатили",
            "inconclusive": "без эффекта"}.get(str(d or "").lower(), d or "—")


def build():
    tests = load_tests()
    live = [t for t in tests if t.get("stage") != "closed"]
    done = [t for t in tests if t.get("stage") == "closed"]
    mine = my_products()
    plats = [p for p, v in CFG["platforms"].items() if (v.get("product") or all_products()[0]) in mine]
    slot_data = {p: slot_live(p) for p in plats}

    # платформа показывается, если есть данные в слотах или есть тесты в трекере
    def has_activity(p):
        d = slot_data.get(p)
        return bool(d) and any(d.get(s) for s in SLOTS)
    shown = [p for p in plats if has_activity(p)]
    hidden = [CFG["platforms"][p]["name"] for p in plats if p not in shown]

    dirty_n = 0
    slot_html = ""
    for p in shown:
        name = CFG["platforms"][p]["name"]
        data = slot_data.get(p)
        cells = ""
        for slot in SLOTS:
            planned = [t for t in live if t.get("platform") == p and t.get("slot") == slot]
            if data is None:
                cells += f'<div class="slot unknown" data-f="unknown"><b>{slot}</b><span>нет данных</span></div>'
                continue
            rows = data.get(slot, [])
            if not rows:
                mark, body = "free", "<span>свободен</span>"
            else:
                exps = sorted({v.rsplit("-", 1)[0] for v, _ in rows})
                total = sum(n for _, n in rows)
                mark = "dirty" if len(exps) > 1 else "busy"
                if len(exps) > 1: dirty_n += 1
                body = "".join(f"<span>{e(x)}</span>" for x in exps)
                body += f'<span class="muted">{total:,} участников</span>'.replace(",", " ")
                if len(exps) > 1:
                    body += '<span class="warn">хвост искажает данные</span>'
            if planned:
                body += f'<span class="muted">план: {e(planned[0]["id"])}</span>'
            cells += f'<div class="slot {mark}" data-f="{mark}"><b>{slot}</b>{body}</div>'
        slot_html += f'<div class="plat"><h3>{e(name)}</h3><div class="slots">{cells}</div></div>'

    if hidden:
        slot_html += (f'<div class="muted hid">Скрыты платформы без экспериментов: '
                      f'{e(", ".join(hidden))}</div>')

    # ── сводка ──
    over = sum(1 for t in live for _, _, d in deadlines(t) if d < 0)
    debt = sum(1 for t in live if t.get("stage") in DEBT)
    crit_n = sum(1 for t in live if any(c for c, _ in issues(t)))
    cards = [("активных тестов", len(live), "", "all"),
             ("идут в проде", sum(1 for t in live if t.get("stage") in LIVE), "", "live"),
             ("грязных слотов", dirty_n, "bad" if dirty_n else "", "dirty"),
             ("просрочено", over, "bad" if over else "", "over"),
             ("ждут выпиливания", debt, "warn" if debt else "", "debt"),
             ("всего проведено", len(done), "", "history")]
    sum_html = "".join(
        f'<button class="stat {k}" data-f="{f}"><b>{v}</b><span>{e(l)}</span></button>'
        for l, v, k, f in cards)

    # ── активные ──
    rows = ""
    for t in sorted(live, key=lambda x: list(STAGE_RU).index(x.get("stage", "incoming"))):
        st = t.get("stage", "incoming")
        tone = "live" if st in LIVE else ("debt" if st in DEBT else "prep")
        meta = [e(CFG["platforms"].get(t.get("platform"), {}).get("name", "—"))]
        if t.get("slot"):
            meta.append(f'<code>{e(t["slot"])}</code>')
        meta_html = '<span class="dot">·</span>'.join(meta)

        dl = ""
        for d, lab, days in sorted(deadlines(t), key=lambda r: r[2]):
            k = "over" if days < 0 else ("soon" if days <= 7 else "far")
            txt = f"{lab}: просрочено {-days} дн." if days < 0 else f"{lab}: через {days} дн."
            dl += f'<span class="chip dl {k}">{e(txt)}</span>'

        probs = "".join(f'<span class="chip {"crit" if c else "warn"}">{e(txt)}</span>'
                        for c, txt in issues(t))
        if not probs:
            probs = '<span class="chip ok">всё на месте</span>'

        flags = [tone]
        if any(d < 0 for _, _, d in deadlines(t)):
            flags.append("over")
        if any(c for c, _ in issues(t)):
            flags.append("crit")
        rows += f'''<div class="row {tone}" data-f="{" ".join(flags)}">
  <div class="rhead">
    <div><span class="key">{e(t["id"])}</span>
      <span class="stage {tone}">{e(STAGE_RU.get(st, st))}</span></div>
    <div class="meta">{meta_html}</div>
  </div>
  <div class="rtitle">{e(t.get("title", ""))}</div>
  <div class="chips">{probs}{dl}</div>
  <div class="chips links">{links_of(t)}</div>
</div>'''
    if not rows:
        rows = '<div class="muted">Активных тестов нет</div>'

    # ── история ──
    hist = ""
    for t in sorted(done, key=lambda x: str(x.get("decision_at") or ""), reverse=True):
        removed = t.get("code_removed_version")
        clean = ('<span class="ok">выпилен</span>' if removed
                 else '<span class="warn">не выпилен</span>')
        hist += (f'<tr><td><b>{e(t["id"])}</b> <span class="muted">{e(t.get("title",""))}</span></td>'
                 f'<td>{e(CFG["platforms"].get(t.get("platform"),{}).get("name","—"))}</td>'
                 f'<td>{e(t.get("slot") or "—")}</td>'
                 f'<td>{e(decision_ru(t.get("decision")))}</td>'
                 f'<td>{e(t.get("decision_at") or "—")}</td>'
                 f'<td>{clean}{" " + e(removed) if removed else ""}</td>'
                 f'<td class="issues">{issues_html(t)}</td></tr>')
    hist_html = (f'<table class="compact"><thead><tr><th>Тест</th><th>Платформа</th>'
                 f'<th>Слот</th><th>Решение</th><th>Дата</th><th>Код</th><th>Что не так</th></tr></thead>'
                 f'<tbody>{hist}</tbody></table>' if hist else
                 '<div class="muted">Закрытых тестов в трекере нет. '
                 'Подтянуть историю: <code>/ab-sync</code> в чате.</div>')

    css = """
